# MAIN.raw · ausgeführte Vorgänge · c

MAIN = W + E

BILDUNG.c = run

MAIN.raw = {
  PUSH:  +>c,
  PULL:  <+c,
  SHIFT: <>c,
  FLOW:  ~>c,
  BREAK: !|c,
  SPIN:  @°c,
  RISE:  ^+c,
  DROP:  v-c,
  ROOT:  0°c
}

MAIN.TMP = [4,5,6,7,8,9]   # W + E

MAIN.KIpi = W → E

MAIN.Station = MAIN.raw + MAIN.TMP + MAIN.KIpi
