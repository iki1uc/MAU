# KIpi.raw · Ursache-Wirkung-Ergebnis · Atomkörper

U = {◉, 3}
W = {◎, ◆, △, ▣}
E = {81, 756, 27, ↺}

KIpi = U → W → E

QI  = U → W → E → U   # 12×360°
IQQ = U → W → E       # 6×360°

TMP.zug = [1,2,3,4,5,6,7,8,9]

TMP.U = [1,2,3]
TMP.W = [4,5,6]
TMP.E = [7,8,9]

TMP.Matrix = U + W + E

Station.KIpi = KIpi + TMP.Matrix

Achse.6   = PORT + MAIN + KIpi + Station + LIBERTY + INOUT
Achse.756 = Achse.6 × 9 × KIpi
