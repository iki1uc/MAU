# MAU.raw · offene Vorgänge · a + b

MAU = U + W

BILDUNG.a = src
BILDUNG.b = exe

MAU.raw = {
  PUSH:  +>a +>b,
  PULL:  <+a <+b,
  SHIFT: <>a <>b,
  FLOW:  ~>a ~>b,
  BREAK: !|a !|b,
  SPIN:  @°a @°b,
  RISE:  ^+a ^+b,
  DROP:  v-a v-b,
  ROOT:  0°a 0°b
}

MAU.TMP = [1,2,3,4,5,6]   # U + W

MAU.KIpi = U → W

MAU.Station = MAU.raw + MAU.TMP + MAU.KIpi
